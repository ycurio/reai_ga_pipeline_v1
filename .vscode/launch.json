{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run pipeline (sample leads)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "args": [
        "--leads", "sample_leads.csv",
        "--gsccca-dir", "data/gsccca_exports",
        "--out", "data/output/results.json"
      ],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
